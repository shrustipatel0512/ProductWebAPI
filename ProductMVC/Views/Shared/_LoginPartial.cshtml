@using Microsoft.AspNetCore.Identity;
@inject SignInManager<User> SignInManager;

        <ul style="column-gap: 27px; display: flex; align-items: center; list-style: none; margin-left: 800px;">
        @if (SignInManager.IsSignedIn(User))
        {
            <li>
                <form method="post" asp-area="" asp-controller="Account" asp-action="Logout" id="logoutForm" class="navbar-right">
                    <button type="submit" class="btn btn-link navbar-btn navbar-link">Logout</button>
                </form>
            </li>
        }
        else
        {
           @*  <li><a asp-area="" asp-controller="Account" asp-action="Login">Login</a></li>
            <li><a asp-area="" asp-controller="Account" asp-action="Register">Register</a></li> *@

            <li><a href="/Account/Login">Login</a></li>
            <li><a href="/Account/Register">Register</a></li>

        }
        </ul>